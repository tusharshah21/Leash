# Devnet RPC, for example your Helius devnet URL. Scripts fall back to the public endpoint.
LEASH_RPC_URL=https://api.devnet.solana.com

# The executor and the guard's judge both call OpenAI. Never commit a real key.
OPENAI_API_KEY=
# Needs tool calling, structured outputs and temperature 0. Some newer models reject temperature.
OPENAI_MODEL=gpt-4o-mini

# Where the guard listens (localhost only) and where the agent finds it.
GUARD_PORT=8787
GUARD_URL=http://127.0.0.1:8787

# Optional: send a Telegram message with the Blink link when a proposal needs a human. Needs all
# three, and is skipped cleanly otherwise. NEXT_PUBLIC_SITE_URL is the deployed console.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NEXT_PUBLIC_SITE_URL=https://your-site.example

# Optional overrides. The defaults suit the demo.
# AGENT_KEY_FILE=keys/agent.json
# GUARD_KEY_FILE=keys/guard.json
# LEASH_INVOICES_DIR=demo/invoices
# LEASH_LOG_DIR=logs
# The vault the agent and guard act for. Default: demoVault in demo/devnet.json. --vault also sets it.
# LEASH_VAULT=
# Or pick it by owner instead.
# LEASH_VAULT_OWNER=
# The CLI wallet the devnet scripts pay from. Default: ~/.config/solana/id.json.
# ANCHOR_WALLET=

# The web console has its own env file: see apps/web/.env.example.
