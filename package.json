{
  "name": "leash",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.22.3"
  },
  "scripts": {
    "lint:fix": "prettier \"tests/**/*.ts\" \"scripts/**/*.ts\" \"packages/**/*.ts\" \"apps/**/*.ts\" --print-width 100 -w",
    "lint": "prettier \"tests/**/*.ts\" \"scripts/**/*.ts\" \"packages/**/*.ts\" \"apps/**/*.ts\" --print-width 100 --check",
    "test:fast": "anchor test",
    "test:all": "RUN_SLOW=1 anchor test",
    "test:sdk": "ts-mocha -p ./tsconfig.json \"packages/sdk/test/**/*.ts\"",
    "build:sdk": "pnpm --filter @leash/sdk sync-idl && pnpm --filter @leash/sdk build",
    "deploy:devnet": "bash scripts/deploy-devnet.sh",
    "bootstrap:devnet": "node --env-file-if-exists=.env scripts/bootstrap-devnet.ts",
    "smoke:devnet": "node --env-file-if-exists=.env scripts/smoke-devnet.ts",
    "test:apps": "node --env-file-if-exists=.env --test \"apps/*/test/*.test.ts\"",
    "typecheck": "tsc -p apps/guard/tsconfig.json && tsc -p apps/agent/tsconfig.json && tsc -p scripts/tsconfig.json",
    "agent": "node --env-file-if-exists=.env apps/agent/src/cli.ts",
    "guard": "node --env-file-if-exists=.env apps/guard/src/server.ts",
    "gen:invoices": "node --env-file-if-exists=.env scripts/gen-invoices.ts",
    "demo:fresh": "node --env-file-if-exists=.env scripts/demo-fresh.ts",
    "demo:run": "node --env-file-if-exists=.env scripts/demo-run.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.2",
    "@leash/sdk": "workspace:*"
  },
  "devDependencies": {
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@types/bn.js": "5.2.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "9.1.1",
    "@types/node": "22.20.5",
    "chai": "4.5.0",
    "mocha": "9.2.2",
    "pdf-lib": "1.17.1",
    "prettier": "2.8.8",
    "ts-mocha": "10.1.0",
    "typescript": "5.9.3"
  }
}
