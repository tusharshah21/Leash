# Devnet RPC. This value ships to the browser, so restrict a paid key by domain before deploying.
NEXT_PUBLIC_LEASH_RPC_URL=https://api.devnet.solana.com

# file reads logs/activity.jsonl. Anything else serves the exported snapshot.
ACTIVITY_SOURCE=file

# Local testing only: a JSON secret key that adds a "Dev burner" wallet. Never set this on a deployment.
# NEXT_PUBLIC_DEV_BURNER_KEY=[1,2,3]
